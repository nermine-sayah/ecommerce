pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            when {
                buildingTag()
            }
            steps {
                echo "Building for tag: ${env.GIT_TAG_NAME}"
                sh 'docker build -t ecommerce:${env.GIT_TAG_NAME} .'

                // Création d'un fichier log et info Docker pour artefacts
                sh 'mkdir -p logs && echo "Docker build log" > logs/docker-build.log'
                sh "mkdir -p docker-images && echo 'ecommerce:${env.GIT_TAG_NAME}' > docker-images/tag-info.txt"
            }
        }

        stage('Push Docker Image') {
            when {
                buildingTag()
            }
            steps {
                echo "Pushing Docker image for tag: ${env.GIT_TAG_NAME}"
                sh 'docker push ecommerce:${env.GIT_TAG_NAME}'
            }
        }

        stage('Archive Artifacts') {
            when {
                buildingTag()
            }
            steps {
                echo "Archiving artifacts for tag: ${env.GIT_TAG_NAME}"
                archiveArtifacts artifacts: 'build/**'
                archiveArtifacts artifacts: 'logs/**'
                archiveArtifacts artifacts: 'docker-images/**'
            }
        }
    }

    post {
        success {
            echo "Pipeline finished successfully for tag: ${env.GIT_TAG_NAME}"
        }
        failure {
            echo "Pipeline failed for tag: ${env.GIT_TAG_NAME}"
        }
    }
}
