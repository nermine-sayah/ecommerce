pipeline {
    agent any

    triggers {
        // Trigger GitHub Pull Request
        githubPullRequest()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out the PR code..."
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo "Running build and tests for the PR..."
                bat 'npm install'
                bat 'npm run build'
                bat 'npm test'

                // Création d'un fichier log pour montrer les artefacts
                bat 'mkdir logs && echo PR build log > logs/pr-build.log'
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "Archiving PR build results..."
                archiveArtifacts artifacts: 'build/**'
                archiveArtifacts artifacts: 'logs/**'
                archiveArtifacts artifacts: 'test-results/**'  // si tu as les résultats de test
            }
        }
    }

    post {
        success {
            echo "PR build succeeded!"
        }
        failure {
            echo "PR build failed!"
        }
    }
}
