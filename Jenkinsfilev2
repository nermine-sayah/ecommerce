pipeline {
    agent any

    triggers {
        // هذا trigger خاص بالـ GitHub Pull Request
        githubPullRequest()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out the PR code..."
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo "Running build and tests for the PR..."
                // مثال: لو عندك Node.js project
                bat 'npm install'
                bat 'npm run build'
                bat 'npm test'
            }
        }
    }

    post {
        success {
            echo "PR build succeeded!"
        }
        failure {
            echo "PR build failed!"
        }
    }
}
